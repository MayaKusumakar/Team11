{
  "manifest_version": 3,
  "name": "FakeReview Detector",
  "version": "1.0.0",
  "description": "Detects fake Amazon product reviews using an LSTM model.",

  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://www.amazon.com/*",
    "https://*/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*/product-reviews/*",
        "https://www.amazon.com/product-reviews/*",
        "https://www.amazon.com/dp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "FakeReview Detector"
  },

  "icons": {}
}
